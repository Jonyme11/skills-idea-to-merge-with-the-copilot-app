<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    COUNTER_KEY,
    STORAGE_KEY,
    nextSlug,
    normalizeUrl,
    parseBookmarks,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');

  let bookmarks = [];

  function readCounter() {
    try {
      const value = Number(localStorage.getItem(COUNTER_KEY));
      return Number.isSafeInteger(value) && value >= 0 ? value : 0;
    } catch {
      return 0;
    }
  }

  function saveBookmarks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Keep the in-memory list usable if storage is unavailable.
    }
  }

  function saveCounter(counter) {
    try {
      localStorage.setItem(COUNTER_KEY, String(counter));
    } catch {
      // Counter persistence is optional when storage is unavailable.
    }
  }

  function updateState() {
    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
  }

  function renderBookmarks() {
    if (!list) return;
    list.replaceChildren();

    bookmarks.forEach((bookmark) => {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = `${bookmark.url} :: `;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      link.append(slug);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        } catch {
          copyButton.textContent = 'Copy failed';
        }
      });

      row.append(link, copyButton);
      list.append(row);
    });

    updateState();
  }

  function loadBookmarks() {
    try {
      bookmarks = parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      bookmarks = [];
    }
    renderBookmarks();
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(input instanceof HTMLInputElement)) return;
    const url = normalizeUrl(input.value);
    if (!url) {
      input.setCustomValidity('Enter a valid web URL.');
      input.reportValidity();
      return;
    }

    input.setCustomValidity('');
    let counter = readCounter() + 1;
    let slug = nextSlug(counter);

    const existingSlugs = new Set(bookmarks.map((bookmark) => bookmark.slug));
    while (existingSlugs.has(slug)) {
      counter += 1;
      slug = nextSlug(counter);
    }

    bookmarks = [...bookmarks, { url, slug }];
    saveBookmarks();
    saveCounter(counter);
    renderBookmarks();
    input.value = '';
    input.focus();
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COUNTER_KEY);
    } catch {
      // The in-memory list is still cleared if storage is unavailable.
    }
    renderBookmarks();
  });

  loadBookmarks();
</script>
